{
  "manifest_version": 2,
  "name": "Claude Code for Safari",
  "version": "0.5.0",
  "description": "Lets Claude Code read and drive Safari tabs through a local bridge.",
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page-runtime.js", "content.js"], "run_at": "document_start", "all_frames": false }
  ],
  "web_accessible_resources": ["console-hook.js"],
  "permissions": ["tabs", "activeTab", "webRequest", "webNavigation", "<all_urls>", "http://127.0.0.1/*"],
  "browser_action": { "default_title": "Claude Code for Safari" }
}
